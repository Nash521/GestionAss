{
  "expo": {
    "name": "GestionAss",
    "slug": "gestion-ass",
    "scheme": "gestion-ass",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser GestionAss à choisir le logo de l’association dans vos photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser GestionAss à utiliser Face ID pour vous connecter."
        }
      ],
      "expo-secure-store",
      "./with-presentation-network.cjs"
    ],
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "ci.gestionass.presentation",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e9f4622-8ce7-4f1d-88ae-ee3befd84d67"
      }
    },
    "owner": "nash521"
  }
}
