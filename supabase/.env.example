# Generate 32 random bytes and encode them as base64. Keep the real value only in
# the Edge Functions environment. Never use an EXPO_PUBLIC_ variable for this key.
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# Secret HMAC requis pour les codes de récupération. Générer une valeur aléatoire
# et la conserver dans les secrets des Edge Functions.
OTP_HASH_SECRET=

# Développement local uniquement : affiche les SMS simulés dans les journaux
# de `supabase functions serve`. Ne jamais activer en production.
LOCAL_SMS_LOG_CODES=false

# Fournisseur Orange SMS requis pour un envoi réel en production.
ORANGE_SMS_API_URL=
ORANGE_SMS_ACCESS_TOKEN=
ORANGE_SMS_SENDER=
